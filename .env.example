# PostGIS lokal (docker compose)
DATABASE_URL=postgresql://gis:gis@localhost:5432/gissentry


# Basemap MapLibre (opsional)
NEXT_PUBLIC_BASEMAP_STYLE=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json

# OpenCode Go (backend copilot, tidak ditampilkan di UI)
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/v1
OPENCODE_GO_MODEL=deepseek-v4.1-flash
